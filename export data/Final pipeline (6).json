			"calculatedType": "",
			"sqlQuery": "/* 1. New records from Staging */\nWITH new_active AS (\n    SELECT \n        log_st, latitude_id, longitude_id, bolt_count, module_count, \n        mms_count, torque, log_timestamp,\n        CURRENT_DATE AS valid_start,\n        CAST(NULL AS DATE) AS valid_end,\n        CAST(CURRENT_TIMESTAMP AS TIMESTAMP) AS ins_dt,\n        CAST(CURRENT_TIMESTAMP AS TIMESTAMP) AS upd_dt,\n        1 AS latest_flag\n    FROM myDataSource\n),\n\n/* 2. Create the '0' History record using Staging for the JOIN */\ndeactivated_old AS (\n    SELECT \n        t.log_st, t.latitude_id, t.longitude_id, t.bolt_count, t.module_count,\n        t.mms_count, t.torque, t.log_timestamp, \n        t.valid_start,\n        CURRENT_DATE-1 AS valid_end, \n        t.ins_dt,\n        CAST(CURRENT_TIMESTAMP AS TIMESTAMP) AS upd_dt,\n        0 AS latest_flag\n    FROM glue_catalog.tatadata_db.qa_ods_final t\n    INNER JOIN myDataSource n -- Joining against staging data to find matches\n        ON t.latitude_id = n.latitude_id \n        AND t.longitude_id = n.longitude_id\n    WHERE t.latest_flag = 1\n)\n\n/* Final Selection: Exactly 13 columns */\nSELECT * FROM new_active\nUNION ALL\nSELECT * FROM deactivated_old",
			"codeGenVersion": 2
		},
