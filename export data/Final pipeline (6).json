			"parentsValid": true,
			"calculatedType": "",
			"sqlQuery": "/* 1. Generate unique GPS IDs and Site Names from the filtered stream */\nWITH base_data AS (\n    SELECT \n        *,\n        /* Assign a unique number to every unique Lat/Long pair */\n        DENSE_RANK() OVER (ORDER BY latitude_id, longitude_id) AS generated_gps_id,\n        /* Create the geo-location string */\n        CONCAT('site_', CAST(latitude_id AS STRING), '_', CAST(longitude_id AS STRING)) AS generated_site_location\n    FROM myDataSource -- Refers to the output of the Filter Node\n),\n\n/* 2. Deduplicate to isolate the maximum progress record per location */\nranked_data AS (\n    SELECT \n        *,\n        ROW_NUMBER() OVER (\n            PARTITION BY latitude_id, longitude_id \n            ORDER BY bolt_count DESC, log_timestamp DESC\n        ) AS rn\n    FROM base_data\n)\n\n/* 3. Final Output with Audit Tracking Columns */\nSELECT \n    log_st, latitude_id, longitude_id, bolt_count, module_count, \n    mms_count, torque, log_timestamp, \n    generated_gps_id AS gps_id, \n    generated_site_location AS site_geo_location,\n    CURRENT_DATE AS valid_start,\n    CAST(NULL AS DATE) AS valid_end,\n    CAST(CURRENT_TIMESTAMP AS TIMESTAMP) AS ins_dt,\n    CAST(CURRENT_TIMESTAMP AS TIMESTAMP) AS upd_dt,\n    1 AS latest_flag\nFROM ranked_data\nWHERE rn = 1\n",
			"codeGenVersion": 2
		},
